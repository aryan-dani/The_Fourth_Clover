{
  "name": "the-fourth-clover",
  "version": "0.1.0",
  "private": true,
  "description": "Editorial publication — Journal writing & CSI Tech Weekly from CSI MIT-WPU",
  "engines": {
    "node": ">=20.9.0",
    "npm": ">=10"
  },
  "homepage": "https://fourthclover.bio",
  "repository": {
    "type": "git",
    "url": "https://github.com/aryan-dani/The-Fourth-Clover.git"
  },
  "author": "Aryan Dani",
  "keywords": [
    "blog",
    "journal",
    "nextjs",
    "supabase",
    "typescript",
    "tailwind",
    "csi",
    "writing",
    "poetry"
  ],
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next build && next start",
    "serve": "next start",
    "prepare": "cd .. && husky",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx --max-warnings 0",
    "lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "type-check": "tsc --noEmit",
    "check:markup": "node scripts/check-markup.mjs --self-test && node scripts/check-markup.mjs",
    "check": "npm run lint && npm run type-check && npm run check:markup",
    "clean": "rm -rf .next out dist build",
    "analyze": "ANALYZE=true npm run build",
    "db:inspect": "node scripts/inspect-schema.js",
    "db:query": "node scripts/query-tool.js",
    "db:verify": "node scripts/verify-supabase.js",
    "seed:roster": "node scripts/seed-roster.js",
    "test:security": "node scripts/test-rls-security.js"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@hookform/resolvers": "^3.9.0",
    "@radix-ui/react-alert-dialog": "^1.1.1",
    "@radix-ui/react-avatar": "^1.1.0",
    "@radix-ui/react-checkbox": "^1.1.1",
    "@radix-ui/react-collapsible": "^1.1.0",
    "@radix-ui/react-dialog": "^1.1.1",
    "@radix-ui/react-dropdown-menu": "^2.1.1",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-popover": "^1.1.1",
    "@radix-ui/react-progress": "^1.1.0",
    "@radix-ui/react-scroll-area": "^1.1.0",
    "@radix-ui/react-select": "^2.1.1",
    "@radix-ui/react-separator": "^1.1.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-switch": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.0",
    "@radix-ui/react-toast": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.1.2",
    "@supabase/ssr": "^0.6.1",
    "@supabase/supabase-js": "^2.39.0",
    "@tanstack/react-table": "^8.21.3",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "cmdk": "^1.0.0",
    "date-fns": "^3.6.0",
    "gsap": "^3.15.0",
    "lenis": "^1.3.27",
    "lucide-react": "^0.446.0",
    "next": "^16.0.10",
    "next-themes": "^0.4.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.53.0",
    "react-markdown": "^10.1.0",
    "react-textarea-autosize": "^8.5.3",
    "rehype-highlight": "^7.0.2",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^1.5.0",
    "tailwind-merge": "^2.5.2",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.3",
    "@eslint/js": "^9.39.2",
    "@netlify/plugin-nextjs": "^5.15.10",
    "@types/node": "^24.0.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "10.4.15",
    "dotenv": "^16.5.0",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.0.0",
    "husky": "^9.1.7",
    "postcss": "^8.5.6",
    "tailwindcss": "3.3.3",
    "typescript": "5.2.2"
  }
}

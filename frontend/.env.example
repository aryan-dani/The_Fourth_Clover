# Supabase Configuration
# Get these from your Supabase project dashboard
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Server-only secrets (never expose to the client or commit real values)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
PRN_HASH_SECRET=generate_a_32_byte_hex_secret_for_hmac_sha256
SUPER_ADMIN_EMAIL=your_super_admin_google_email@example.com

# Public site URL (optional, used for canonical metadata and OG URLs)
NEXT_PUBLIC_SITE_URL=https://fourthclover.bio
